rules_version = '2';

// ============================================================
// Reglas de seguridad de Mi Kanban
// Cada usuario solo puede leer y escribir SUS tableros:
//   users/{uid}/boards/{boardId}
//   users/{uid}/boards/{boardId}/cards/{cardId}
// Todo lo demás queda denegado por defecto.
// Ojo (lección NEXORA): cada función se USA en un allow; ninguna
// queda declarada sin llamarse.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function validBoard() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'columns', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['name', 'columns', 'createdAt', 'updatedAt'])
        && isText(d.name, 1, 80)
        && d.columns is list && d.columns.size() <= 30
        && d.createdAt is number
        && d.updatedAt is number;
    }

    function validCard() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'notes', 'color', 'dueDate', 'columnId', 'order', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['title', 'notes', 'color', 'dueDate', 'columnId', 'order', 'createdAt', 'updatedAt'])
        && isText(d.title, 1, 200)
        && isText(d.notes, 0, 2000)
        && d.color in ['', 'red', 'orange', 'yellow', 'green', 'blue', 'purple']
        && isText(d.dueDate, 0, 10)
        && isText(d.columnId, 1, 40)
        && d.order is number
        && d.createdAt is number
        && d.updatedAt is number;
    }

    match /users/{uid}/boards/{boardId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validBoard();

      match /cards/{cardId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validCard();
      }
    }
  }
}
